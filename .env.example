# Copy to .env and fill in, then `export $(grep -v '^#' .env | xargs)` before
# running, or use any dotenv loader / your shell's own env var mechanism.
# CLI flags (--anthropic-key, --gemini-key) always override these.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Either name works; GEMINI_API_KEY is checked first.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-pro
