# Copy to .env and fill in, then `export $(grep -v '^#' .env | xargs)` before
# running, or use any dotenv loader / your shell's own env var mechanism.
# CLI flags always override these; these override config.yaml.
#
# On a shared HPC filesystem: `chmod 600 .env`, never commit it, and never put
# real keys in a script that's checked into git or world-readable. See
# docs/HPC_SETUP.md for the full secure-storage walkthrough.

# ---- Option A: Perplexity API backend (one key drives BOTH reviewer roles) ----
# Recommended if you only have a Perplexity API key. Get one at
# https://console.perplexity.ai (separate from your Perplexity account /
# Computer credits -- see docs/HPC_SETUP.md).
PERPLEXITY_API_KEY=
PERPLEXITY_CLAUDE_MODEL=anthropic/claude-sonnet-5
PERPLEXITY_GEMINI_MODEL=google/gemini-3.1-pro-preview

# Force the backend explicitly instead of relying on auto-detection
# (auto = perplexity if PERPLEXITY_API_KEY is set, else direct):
# TITAN_CURATE_BACKEND=perplexity

# ---- Option B: direct provider keys (bring your own Anthropic + Google keys) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Either name works; GEMINI_API_KEY is checked first.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-pro
